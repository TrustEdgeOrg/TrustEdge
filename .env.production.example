# Root-level env for `docker compose` variable substitution.
# Copy to `.env` on the EC2 host (same directory as docker-compose.yml):
#   cp .env.production.example .env
#
# Docker Compose reads this file automatically for ${VAR} interpolation in docker-compose.yml.

# TrustEdge Agent ingest API (separate repo; image from ECR)
# TRUSTEDGE_AGENT_API_IMAGE=804012660077.dkr.ecr.us-east-1.amazonaws.com/trustedge-agent-api:latest
# TRUSTEDGE_AGENT_API_PORT=8080
# TRUSTEDGE_AGENT_API_HOST_BIND=0.0.0.0
# TRUSTEDGE_AGENT_ENROLL_TOKEN=  # generated on first deploy → /etc/trustedge/agent-enroll.token
# TRUSTEDGE_AGENT_PRODUCTION=1

# Kafka/Redpanda event bus (trustedge-agent-api produces; detection-engine consumes)
# KAFKA_BROKERS=redpanda:9092
# KAFKA_TOPIC=trustedge.agent.events

# Optional Redpanda Console. Start with COMPOSE_PROFILES=console; the UI is
# bound to localhost and should be accessed through an SSH tunnel.
# REDPANDA_CONSOLE_PORT=8081
# REDPANDA_CONSOLE_IMAGE=docker.redpanda.com/redpandadata/console:v2.8.8
